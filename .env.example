# Copy this file to .env for local settings.

# DATABASE_URL: Postgres connection string (e.g. from Neon or Supabase). Without it,
# clinic records and staff accounts live in memory and are lost when the server restarts.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# SESSION_SECRET: long random string used to sign staff sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, everyone is signed out whenever the server restarts.
# SESSION_SECRET="replace-with-a-long-random-string"

# GEMINI_API_KEY: optional, enables the AI Code & Prompt Auditor screen.
# GEMINI_API_KEY="your-gemini-api-key"

# PORT: optional, defaults to 3000 (hosting platforms set this for you).
# PORT=3000
